<!DOCTYPE html>
<html lang="pt">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>Free capa</title>
  <style>
    html, body { margin: 0; height: 100%; background: #0b1020; overflow: hidden; touch-action: none; user-select: none; font-family: system-ui, sans-serif; }
    canvas { display: block; }
    #dash { position: fixed; right: 20px; bottom: 200px; width: 72px; height: 72px; border-radius: 50%; border: 3px solid #ffb703; background: rgba(255,183,3,.18); color: #ffb703; font-weight: bold; font-size: 14px; }
    #fire { position: fixed; right: 24px; bottom: 80px; width: 96px; height: 96px; border-radius: 50%; border: 4px solid #ff3b6b; background: rgba(255,59,107,.25); color: #ff3b6b; font-weight: bold; font-size: 16px; }
    #ov { position: fixed; inset: 0; background: rgba(5,8,18,.82); color: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 14px; padding: 20px; }
    #ov h1 { margin: 0; font-size: 44px; color: #ffb703; }
    #ov p { margin: 0; max-width: 320px; line-height: 1.4; color: #cfd6ea; }
    #ov button { padding: 14px 36px; font-size: 20px; border: 0; border-radius: 10px; background: #ffb703; font-weight: bold; }
  </style>
</head>

<body>
  <canvas id="c"></canvas>
  <button id="dash">DASH</button>
  <button id="fire">ATIRAR</button>
  <div id="ov">
    <h1>FREE CAPA</h1>
    <p>8 heróis de capa, 1 mapa que encolhe. Sobreviva até o fim.<br><br>Esquerda: mover.<br>Direita: arrastar para mirar e atirar.<br>ATIRAR: segure para atirar no inimigo mais próximo.<br>DASH: pulo rápido.</p>
    <button id="go">JOGAR</button>
  </div>

<script>
const cv = document.getElementById('c'), ctx = cv.getContext('2d');
const ov = document.getElementById('ov'), dashBtn = document.getElementById('dash');
let W, H;
function resize() { W = cv.width = innerWidth; H = cv.height = innerHeight; }
addEventListener('resize', resize); resize();

const M = 2400, R = 16;
let ents, bullets, walls, picks, P, t, running = false, msg = '';
let fireBtn, mv = null, aim = null, keys = {}, mouse = null;

const rnd = (a, b) => a + Math.random() * (b - a);

function start() {
  walls = []; picks = []; bullets = []; t = 0;
  for (let i = 0; i < 40; i++) walls.push({ x: rnd(100, M - 200), y: rnd(100, M - 200), w: rnd(50, 160), h: rnd(50, 160) });
  P = { x: rnd(900, 1500), y: rnd(900, 1500), hp: 100, a: 0, col: '#ffb703', cd: 0, dash: 0, dcd: 0, me: true, alive: true };
  ents = [P];
  for (let i = 0; i < 7; i++) ents.push({ x: rnd(100, M - 100), y: rnd(100, M - 100), hp: 100, a: 0, col: 'hsl(' + (i * 50 + 180) + ',70%,60%)', cd: 1, tx: 0, ty: 0, wt: 0, alive: true });
  ents.forEach(e => push(e));
  for (let i = 0; i < 16; i++) picks.push({ x: rnd(100, M - 100), y: rnd(100, M - 100) });
  msg = ''; ov.style.display = 'none'; running = true; last = performance.now();
  requestAnimationFrame(loop);
}
document.getElementById('go').onclick = start;

function push(e) {
  for (const w of walls) {
    const nx = Math.max(w.x, Math.min(e.x, w.x + w.w)), ny = Math.max(w.y, Math.min(e.y, w.y + w.h));
    let dx = e.x - nx, dy = e.y - ny, d = Math.hypot(dx, dy);
    if (d < R) {
      if (d === 0) { e.x += R; continue; }
      e.x = nx + dx / d * R; e.y = ny + dy / d * R;
    }
  }
  e.x = Math.max(R, Math.min(M - R, e.x)); e.y = Math.max(R, Math.min(M - R, e.y));
}

function shoot(e, a) {
  bullets.push({ x: e.x + Math.cos(a) * 20, y: e.y + Math.sin(a) * 20, vx: Math.cos(a) * 750, vy: Math.sin(a) * 750, life: 0.9, o: e });
}

// ---------- controles ----------
addEventListener('touchstart', e => {
  if (e.target.tagName === 'BUTTON') return;
  e.preventDefault();
  for (const c of e.changedTouches) {
    const j = { id: c.identifier, ox: c.clientX, oy: c.clientY, x: 0, y: 0 };
    if (c.clientX < W / 2) { if (!mv) mv = j; } else { if (!aim) aim = j; }
  }
}, { passive: false });
addEventListener('touchmove', e => {
  e.preventDefault();
  for (const c of e.changedTouches) for (const j of [mv, aim]) if (j && j.id === c.identifier) {
    let dx = c.clientX - j.ox, dy = c.clientY - j.oy, d = Math.hypot(dx, dy), m = Math.min(d, 60);
    j.x = d ? dx / d * m / 60 : 0; j.y = d ? dy / d * m / 60 : 0;
  }
}, { passive: false });
const endT = e => { for (const c of e.changedTouches) { if (mv && mv.id === c.identifier) mv = null; if (aim && aim.id === c.identifier) aim = null; } };
addEventListener('touchend', endT); addEventListener('touchcancel', endT);
dashBtn.addEventListener('touchstart', e => { e.preventDefault(); doDash(); }, { passive: false });
dashBtn.addEventListener('mousedown', doDash);
let firing = false;
fireBtn = document.getElementById('fire');
['touchstart','mousedown'].forEach(n => fireBtn.addEventListener(n, e => { e.preventDefault(); firing = true; }, { passive: false }));
['touchend','touchcancel','mouseup','mouseleave'].forEach(n => fireBtn.addEventListener(n, () => firing = false));
function doDash() { if (running && P.dcd <= 0) { P.dash = 0.2; P.dcd = 3; } }
addEventListener('keydown', e => { keys[e.key.toLowerCase()] = 1; if (e.key === ' ') doDash(); });
addEventListener('keyup', e => keys[e.key.toLowerCase()] = 0);
addEventListener('mousedown', e => { if (e.target.tagName !== 'BUTTON') mouse = { x: e.clientX, y: e.clientY }; });
addEventListener('mousemove', e => { if (mouse) mouse = { x: e.clientX, y: e.clientY }; });
addEventListener('mouseup', () => mouse = null);

// ---------- lógica ----------
function zoneR() { return Math.max(110, 1250 - 1140 * (t / 120)); }

function update(dt) {
  t += dt;
  const zr = zoneR(), zc = M / 2;

  // jogador
  let mx = (mv ? mv.x : 0) + (keys.d ? 1 : 0) - (keys.a ? 1 : 0), my = (mv ? mv.y : 0) + (keys.s ? 1 : 0) - (keys.w ? 1 : 0);
  const ml = Math.hypot(mx, my); if (ml > 1) { mx /= ml; my /= ml; }
  let sp = 190; if (P.dash > 0) { sp = 650; P.dash -= dt; }
  P.dcd -= dt; P.cd -= dt;
  P.x += mx * sp * dt; P.y += my * sp * dt; push(P);
  let ax = aim ? aim.x : 0, ay = aim ? aim.y : 0;
  if (mouse) { ax = mouse.x - W / 2; ay = mouse.y - H / 2; const l = Math.hypot(ax, ay) || 1; ax /= l; ay /= l; }
  let want = false;
  if (Math.hypot(ax, ay) > 0.25) { P.a = Math.atan2(ay, ax); want = true; }
  else {
    if (ml > 0.1) P.a = Math.atan2(my, mx);
    if (firing) {
      let tg = null, td = 550;
      for (const o of ents) if (o !== P && o.alive) { const d = Math.hypot(o.x - P.x, o.y - P.y); if (d < td) { td = d; tg = o; } }
      if (tg) P.a = Math.atan2(tg.y - P.y, tg.x - P.x);
      want = true;
    }
  }
  if (want && P.cd <= 0) { shoot(P, P.a); P.cd = 0.22; }

  // bots
  for (const b of ents) {
    if (b.me || !b.alive) continue;
    b.cd -= dt; b.wt -= dt;
    let near = null, nd = 380;
    for (const o of ents) if (o !== b && o.alive) { const d = Math.hypot(o.x - b.x, o.y - b.y); if (d < nd) { nd = d; near = o; } }
    if (b.wt <= 0) { b.tx = rnd(-1, 1); b.ty = rnd(-1, 1); b.wt = rnd(1, 3); }
    let dx = b.tx, dy = b.ty;
    if (Math.hypot(b.x - zc, b.y - zc) > zr - 100) { dx = zc - b.x; dy = zc - b.y; }
    else if (near && nd > 160) { dx = near.x - b.x; dy = near.y - b.y; }
    const l = Math.hypot(dx, dy) || 1;
    b.x += dx / l * 115 * dt; b.y += dy / l * 115 * dt; push(b);
    if (near) {
      b.a = Math.atan2(near.y - b.y, near.x - b.x);
      if (b.cd <= 0) { shoot(b, b.a + rnd(-0.28, 0.28)); b.cd = rnd(0.6, 1.1); }
    } else b.a = Math.atan2(dy, dx);
  }

  // balas
  for (const bl of bullets) {
    bl.x += bl.vx * dt; bl.y += bl.vy * dt; bl.life -= dt;
    for (const w of walls) if (bl.x > w.x && bl.x < w.x + w.w && bl.y > w.y && bl.y < w.y + w.h) bl.life = 0;
    for (const e of ents) if (e.alive && e !== bl.o && Math.hypot(e.x - bl.x, e.y - bl.y) < R) {
      e.hp -= 20; bl.life = 0;
      if (e.hp <= 0) e.alive = false;
    }
  }
  bullets = bullets.filter(b => b.life > 0);

  // zona e cura
  for (const e of ents) if (e.alive) {
    if (Math.hypot(e.x - zc, e.y - zc) > zr) { e.hp -= 6 * dt; if (e.hp <= 0) e.alive = false; }
    for (let i = picks.length - 1; i >= 0; i--) if (Math.hypot(e.x - picks[i].x, e.y - picks[i].y) < 24 && e.hp < 100) { e.hp = Math.min(100, e.hp + 35); picks.splice(i, 1); }
  }

  const left = ents.filter(e => e.alive).length;
  if (!P.alive) end('VOCÊ CAIU', 'Sobraram ' + (left) + '. Tente de novo!');
  else if (left === 1) end('VITÓRIA!', 'Você é o último herói de pé.');
}
function end(title, text) {
  running = false;
  ov.innerHTML = '<h1>' + title + '</h1><p>' + text + '</p><button onclick="start()">JOGAR DE NOVO</button>';
  ov.style.display = 'flex';
}

// ---------- desenho ----------
function drawEnt(e) {
  ctx.save(); ctx.translate(e.x, e.y); ctx.rotate(e.a);
  ctx.globalAlpha = .7; ctx.fillStyle = e.col;                 // capa
  ctx.beginPath(); ctx.moveTo(0, -12); ctx.lineTo(-R - 20, -4); ctx.lineTo(-R - 26, 0); ctx.lineTo(-R - 20, 4); ctx.lineTo(0, 12); ctx.fill();
  ctx.globalAlpha = 1;
  ctx.fillStyle = '#2b2f45'; ctx.beginPath(); ctx.ellipse(0, 0, 9, 14, 0, 0, 7); ctx.fill();   // tronco
  ctx.strokeStyle = '#e8b98a'; ctx.lineWidth = 5; ctx.lineCap = 'round';                        // braços
  ctx.beginPath(); ctx.moveTo(2, -12); ctx.lineTo(22, -3); ctx.moveTo(2, 12); ctx.lineTo(22, 3); ctx.stroke();
  ctx.fillStyle = '#15151c'; ctx.fillRect(16, -3.5, 22, 7);                                     // arma
  ctx.fillStyle = '#e8b98a'; ctx.beginPath(); ctx.arc(1, 0, 9, 0, 7); ctx.fill();               // cabeça
  ctx.fillStyle = e.col; ctx.beginPath(); ctx.arc(-1, 0, 9, Math.PI / 2, -Math.PI / 2); ctx.fill(); // cabelo/capuz
  ctx.restore();
  ctx.fillStyle = '#000a'; ctx.fillRect(e.x - 20, e.y - 28, 40, 5);
  ctx.fillStyle = e.hp > 40 ? '#4ade80' : '#f87171'; ctx.fillRect(e.x - 20, e.y - 28, 40 * Math.max(0, e.hp) / 100, 5);
}

function draw() {
  ctx.fillStyle = '#16203a'; ctx.fillRect(0, 0, W, H);
  ctx.save(); ctx.translate(W / 2 - P.x, H / 2 - P.y);
  ctx.fillStyle = '#1d2a4a'; ctx.fillRect(0, 0, M, M);
  ctx.strokeStyle = '#ffffff0d'; ctx.lineWidth = 1; ctx.beginPath();
  for (let i = 0; i <= M; i += 100) { ctx.moveTo(i, 0); ctx.lineTo(i, M); ctx.moveTo(0, i); ctx.lineTo(M, i); }
  ctx.stroke();
  for (const p of picks) { ctx.fillStyle = '#4ade80'; ctx.fillRect(p.x - 9, p.y - 3, 18, 6); ctx.fillRect(p.x - 3, p.y - 9, 6, 18); }
  ctx.fillStyle = '#3b4a73'; for (const w of walls) ctx.fillRect(w.x, w.y, w.w, w.h);
  ctx.fillStyle = '#ffd166'; for (const b of bullets) { ctx.beginPath(); ctx.arc(b.x, b.y, 4, 0, 7); ctx.fill(); }
  for (const e of ents) if (e.alive) drawEnt(e);
  // zona
  ctx.fillStyle = 'rgba(220,30,70,.32)'; ctx.beginPath();
  ctx.rect(-2000, -2000, M + 4000, M + 4000); ctx.arc(M / 2, M / 2, zoneR(), 0, 7); ctx.fill('evenodd');
  ctx.strokeStyle = '#ff3b6b'; ctx.lineWidth = 4; ctx.beginPath(); ctx.arc(M / 2, M / 2, zoneR(), 0, 7); ctx.stroke();
  ctx.restore();

  // joysticks
  for (const j of [mv, aim]) if (j) {
    ctx.strokeStyle = '#ffffff55'; ctx.lineWidth = 3; ctx.beginPath(); ctx.arc(j.ox, j.oy, 60, 0, 7); ctx.stroke();
    ctx.fillStyle = '#ffffff55'; ctx.beginPath(); ctx.arc(j.ox + j.x * 60, j.oy + j.y * 60, 24, 0, 7); ctx.fill();
  }
  // HUD
  ctx.fillStyle = '#fff'; ctx.font = 'bold 18px system-ui';
  ctx.fillText('Vivos: ' + ents.filter(e => e.alive).length, 16, 56);
  ctx.fillStyle = '#000a'; ctx.fillRect(16, 68, 160, 12);
  ctx.fillStyle = '#4ade80'; ctx.fillRect(16, 68, 160 * Math.max(0, P.hp) / 100, 12);
  ctx.fillStyle = P.dcd > 0 ? '#999' : '#ffb703'; ctx.font = '14px system-ui';
  ctx.fillText(P.dcd > 0 ? 'Dash: ' + P.dcd.toFixed(1) + 's' : 'Dash pronto', 16, 100);
}

let last = 0;
function loop(now) {
  const dt = Math.min(0.05, (now - last) / 1000); last = now;
  if (running) { update(dt); }
  draw();
  if (running) requestAnimationFrame(loop);
}
</script>
</body>

</html>
  
